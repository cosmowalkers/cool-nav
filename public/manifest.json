{
  "manifest_version": 3,
  "name": "Cool Nav",
  "version": "0.1.0",
  "description": "自用的极简新标签页：搜索 + 分组快捷方式。",
  "chrome_url_overrides": { "newtab": "index.html" },
  "permissions": ["storage", "favicon"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
